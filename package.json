{
  "name": "paseo-streamdeck",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Stream Deck plugin showing live Paseo agent status (running / needs attention / done)",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.lucaslosi.paseo-status\"",
    "typecheck": "tsc --noEmit",
    "preview:svg": "tsx scripts/preview-svg.ts",
    "validate": "streamdeck validate com.lucaslosi.paseo-status.sdPlugin",
    "pack": "npm run build && streamdeck pack com.lucaslosi.paseo-status.sdPlugin -f",
    "link": "npm run build && streamdeck link com.lucaslosi.paseo-status.sdPlugin"
  },
  "devDependencies": {
    "@elgato/cli": "^1.9.0",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "^22.13.0",
    "@types/ws": "^8.18.1",
    "rollup": "^4.32.1",
    "tslib": "^2.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.2",
    "@getpaseo/client": "0.7.2",
    "ws": "^8.21.3"
  }
}
